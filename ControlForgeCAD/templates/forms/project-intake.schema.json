{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whrsdaparty.github.io/integracab-open/project-intake.schema.json",
  "title": "IntegraCAB Open Project Intake",
  "type": "object",
  "required": ["project", "deliverables", "contacts"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": {"type": "string"},
        "customer": {"type": "string"},
        "site": {"type": "string"},
        "status": {"type": "string", "enum": ["draft", "requested", "active", "on_hold", "complete"]}
      }
    },
    "deliverables": {
      "type": "object",
      "properties": {
        "panelLayout": {"type": "boolean"},
        "ioList": {"type": "boolean"},
        "wiringSchedule": {"type": "boolean"},
        "bomSourceExport": {"type": "boolean"},
        "costingExport": {"type": "boolean"},
        "hmiRequirements": {"type": "boolean"},
        "bimHandoff": {"type": "boolean"},
        "digitalTwinSeed": {"type": "boolean"}
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "name"],
        "properties": {
          "role": {"type": "string"},
          "name": {"type": "string"},
          "email": {"type": "string"},
          "organization": {"type": "string"}
        }
      }
    },
    "powerFeed": {
      "type": "object",
      "properties": {
        "sourceTransformer": {"type": "string"},
        "sourceCircuit": {"type": "string"},
        "nominalVoltage": {"type": "string"},
        "phaseCount": {"type": "string"},
        "frequency": {"type": "string"},
        "feederAmpacity": {"type": "string"},
        "availableFaultCurrent": {"type": "string"},
        "requiredSccr": {"type": "string"},
        "status": {"type": "string", "enum": ["Unknown", "Requested", "Received", "Assumed", "Estimated", "Verified", "Approved", "Rejected", "Superseded"]}
      }
    }
  }
}
