<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="panelHardwareCatalog">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="sources" type="sourcesType" minOccurs="0"/>
        <xs:element name="parts" type="partsType"/>
      </xs:sequence>
      <xs:attribute name="schemaVersion" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="sourcesType">
    <xs:sequence>
      <xs:element name="source" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="id" type="xs:ID" use="required"/>
          <xs:attribute name="title" type="xs:string" use="required"/>
          <xs:attribute name="url" type="xs:anyURI"/>
          <xs:attribute name="localPath" type="xs:string"/>
          <xs:attribute name="sha256" type="xs:string"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="partsType">
    <xs:sequence>
      <xs:element name="part" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="layoutName" type="xs:string" use="required"/>
          <xs:attribute name="manufacturer" type="xs:string" use="required"/>
          <xs:attribute name="partNumber" type="xs:string" use="required"/>
          <xs:attribute name="description" type="xs:string" use="required"/>
          <xs:attribute name="verified" type="xs:boolean" default="false"/>
          <xs:attribute name="sourceId" type="xs:string"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
